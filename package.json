{
  "name": "pendulum-simulation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "backend:build": "npm run build -w backend",
    "backend:dev": "npm run dev -w backend",
    "backend:format": "npm run format -w backend",
    "backend:start": "npm start -w backend",
    "backend:test": "npm test -w backend",
    "build": "run-s -l backend:build frontend:build",
    "dev": "run-p -l mqtt:start backend:dev frontend:dev",
    "format": "run-s -l backend:format frontend:format",
    "start": "run-p -l mqtt:start backend:start frontend:start",
    "test": "run-s -l backend:test",
    "frontend:build": "npm run build -w frontend",
    "frontend:dev": "npm run dev -w frontend",
    "frontend:format": "npm run format -w frontend",
    "frontend:start": "npm start -w frontend",
    "mqtt:start": "aedes start --ws-port 3002 --protos tcp ws",
    "mqtt:log": "mqtt sub -t '#' -h localhost -v"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "workspaces": [
    "backend",
    "frontend",
    "common"
  ],
  "devDependencies": {
    "mqtt-cli": "^0.2.4",
    "prettier": "^3.8.1"
  },
  "dependencies": {
    "aedes-cli": "^0.9.0",
    "npm-run-all": "^4.1.5"
  }
}
